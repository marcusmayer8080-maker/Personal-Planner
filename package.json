{
  "name": "my-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply planner --local",
    "db:migrate:remote": "wrangler d1 migrations apply planner --remote",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "check:rules": "node scripts/check-rules.mjs",
    "deploy": "npm test && npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
